# ---------------------------------------------------------------------------
# AuRA configuration
#
#   cp config/aura.env.example config/aura.env   # then edit config/aura.env
#
# Every script in scripts/ sources config/aura.env automatically. To run the
# Python tools directly, load it into your bash shell first:
#
#   set -a; source config/aura.env; set +a
#
# A non-empty value already exported in your shell takes precedence over the
# value written here (`: "${VAR:=default}"`; an exported empty value does not),
# except AURA_REPO_ROOT, which the scripts in scripts/ always set themselves.
# Loading this file exports its values, so after editing it (or to switch
# checkouts) open a new terminal or `unset ${!AURA_*} ANYGRASP_ENV` first.
#
# Paths default to locations inside this repository; data/,
# third_party/Grounded-SAM-2/, third_party/anygrasp_sdk/ and the contents of
# calibration/ and checkpoints/ are git-ignored. Write any path you set as an
# absolute path, using $HOME/... rather than ~/...: bash does not expand a ~
# inside the double quotes used below (nor in a quoted value such as
# AURA_DATA_ROOT="~/x" in your shell), and most tools then take it literally,
# for example writing cases into a directory named "~" under the current
# directory. Do not use relative paths either: each tool resolves them against
# its own working directory.
# ---------------------------------------------------------------------------

# Repository root, auto-detected when this file is sourced from bash (from any
# other shell, export AURA_REPO_ROOT first).
# - The scripts in scripts/ set it to their own checkout before they source
#   this file, so an exported AURA_REPO_ROOT does not affect them. Their
#   --aura-root option takes effect only after this file is loaded, so the
#   paths below still default into the scripts' own checkout.
# - Python tools run by hand prefer an exported AURA_REPO_ROOT to the checkout
#   that contains them.
if [ -z "${AURA_REPO_ROOT:-}" ] && [ -z "${BASH_SOURCE:-}" ]; then
  echo "config/aura.env: source this file from bash, or export" \
    "AURA_REPO_ROOT=<path to the repository> first" >&2
  return 1
fi
AURA_REPO_ROOT="${AURA_REPO_ROOT:-$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)}"

# --- Hardware --------------------------------------------------------------

# FCI address of the Franka Research 3. REQUIRED by every robot stage.
: "${AURA_ROBOT_IP:=}"

# MXIDs (serial numbers) of the three OAK-D cameras, space separated, in
# camera-index order: index 0, index 1, index 2. REQUIRED by capture and
# recording. Calibration files are named oak_<MXID>.{npz,json}.
: "${AURA_OAK_IDS:=}"

# oak_<MXID> of the camera that observed the gripper-held ChArUco board during
# hand-eye calibration (optional default for --camera-name / --anchor).
: "${AURA_HANDEYE_OAK_ID:=}"

# --- Software environments -------------------------------------------------

# conda environment names (environments/aura.yml, environments/anygrasp.yml)
: "${AURA_ENV:=AuRA}"
: "${ANYGRASP_ENV:=Anygrasp}"

# uv project used to run every script that imports fr3 / pylibfranka
: "${AURA_ROBOT_PROJECT:=$AURA_REPO_ROOT/environments/robot}"

# --- Paths -----------------------------------------------------------------

# Where cases are written: <AURA_DATA_ROOT>/franka_lift/<case>, .../hand_collected/<case>
: "${AURA_DATA_ROOT:=$AURA_REPO_ROOT/data}"

# Your rig's calibration results (see docs/calibration.md for the layout)
: "${AURA_CALIB_ROOT:=$AURA_REPO_ROOT/calibration}"

# Grounded-SAM-2 weights: sam2.1_hiera_large.pt, groundingdino_swint_ogc.pth,
# GroundingDINO_SwinT_OGC.py
: "${AURA_GSAM_CHECKPOINTS:=$AURA_REPO_ROOT/checkpoints/groundedSAM}"

# Your clone of Grounded-SAM-2 (the editable sam2/groundingdino installs);
# it is added to sys.path by the segmentation script.
: "${AURA_GSAM_REPO:=$AURA_REPO_ROOT/third_party/Grounded-SAM-2}"

# Your AnyGrasp SDK checkout (contains grasp_detection/license/ and
# grasp_detection/checkpoint_detection.tar; never part of this repository)
: "${AURA_ANYGRASP_SDK:=$AURA_REPO_ROOT/third_party/anygrasp_sdk}"

# The scripts in scripts/ source this file without `set -a`, so a variable set
# here reaches the programs they start only if it is exported: add any
# variable you introduce to these export lines.
export AURA_REPO_ROOT AURA_ROBOT_IP AURA_OAK_IDS AURA_HANDEYE_OAK_ID
export AURA_ENV ANYGRASP_ENV AURA_ROBOT_PROJECT
export AURA_DATA_ROOT AURA_CALIB_ROOT AURA_GSAM_CHECKPOINTS AURA_GSAM_REPO AURA_ANYGRASP_SDK
